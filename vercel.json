{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 tools/build.py",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/examples",
      "destination": "/use-cases",
      "permanent": true
    },
    {
      "source": "/use-cases/medtech",
      "destination": "/solutions/medtech",
      "permanent": true
    },
    {
      "source": "/use-cases/pharma",
      "destination": "/solutions/pharma",
      "permanent": true
    },
    {
      "source": "/use-cases/health-it-sales",
      "destination": "/solutions/health-it-sales",
      "permanent": true
    },
    {
      "source": "/use-cases/healthcare-marketing",
      "destination": "/solutions/healthcare-marketing",
      "permanent": true
    },
    {
      "source": "/use-cases/investors",
      "destination": "/solutions/investors",
      "permanent": true
    },
    {
      "source": "/use-cases/digital-health",
      "destination": "/solutions/digital-health",
      "permanent": true
    },
    {
      "source": "/use-cases/post-acute",
      "destination": "/solutions/post-acute",
      "permanent": true
    },
    {
      "source": "/use-cases/clinical-staffing",
      "destination": "/solutions/clinical-staffing",
      "permanent": true
    },
    {
      "source": "/use-cases/provider-directories",
      "destination": "/solutions/provider-directories",
      "permanent": true
    },
    {
      "source": "/use-cases/health-systems",
      "destination": "/solutions/health-systems",
      "permanent": true
    },
    {
      "source": "/use-cases/medtech-pharma",
      "destination": "/solutions/medtech",
      "permanent": true
    }
  ]
}
